# Copy to .env.local for local development, or set these in your host's
# environment variables (Vercel: Project → Settings → Environment Variables).
#
# NEXT_PUBLIC_* values are inlined at build time — redeploy after changing them.

# Hosted Supabase project (Settings → API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon or publishable key>

# Local stack instead: run `npm run db:start` and it prints these values.
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# Server only — never prefix with NEXT_PUBLIC_. Used for inviting users,
# disabling them, resetting two-factor and deleting accounts (Auth admin API).
# Supabase dashboard → Settings → API → service_role / secret key.
SUPABASE_SERVICE_ROLE_KEY=<service role key>

# Server only. The mail server the Email button on the lead sheet sends
# through. Any SMTP service works, for example:
#   Resend          smtp.resend.com        user: resend   password: an API key
#   Postmark        smtp.postmarkapp.com   user and password: a server token
#   SendGrid        smtp.sendgrid.net      user: apikey   password: an API key
#   Microsoft 365   smtp.office365.com     a mailbox and its password, if SMTP AUTH is allowed for it
# Port 587 (STARTTLS) or 465 (TLS). The From address is set in the app, under
# Settings › Email, and must be one the service lets this login send from.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASSWORD=<API key or password>
